CANVA_FRONTEND_PORT=8080
CANVA_BACKEND_PORT=3001
CANVA_BACKEND_HOST=http://localhost:3001 # TODO: replace this with your production URL before submitting your app
CANVA_APP_ID=# TODO: Add your app's ID here to configure your backend for JWT verification
CANVA_APP_ORIGIN=# TODO: Add your app's origin here from the "Developer Portal -> Settings -> Security" to enable HMR
CANVA_HMR_ENABLED=FALSE # TODO: set to TRUE to enable HMR

# --- AI image generator ---

# Which image provider to use.
#   mock   - SVG placeholders, no API key, for testing the billing path.
#   openai - real generation via gpt-image-1, needs OPENAI_API_KEY.
IMAGE_PROVIDER=mock

# Required when IMAGE_PROVIDER=openai. Never commit a real key.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TIMEOUT_MS=120000

# Prompt moderation. Runs before any provider call, on both tiers, using
# OpenAI's free moderation endpoint. "open" (default) lets generation proceed
# if that endpoint is unreachable, so an OpenAI incident degrades the filter
# instead of taking the app down; "closed" refuses instead. The local backstop
# for sexualised-minor prompts applies either way.
MODERATION_FAIL_MODE=open

# How long a generated image stays fetchable at /api/assets/<id>, and the
# memory ceiling for that store. Only used in production, where images are
# served as HTTPS URLs rather than inlined as data URLs.
ASSET_TTL_MS=3600000
ASSET_CACHE_MAX_BYTES=536870912

# Where brand kits are stored. Single-instance JSON file; swap the store
# implementation for a database before running more than one backend instance.
BRAND_KIT_DATA_FILE=./data/brand-kits.json

# Daily free generations per user. Keep this generous: Canva's premium app
# guidelines require the free tier to stay genuinely useful.
FREE_GENERATIONS_PER_DAY=25

# Local testing only. Lets premium endpoints run without a real Canva
# entitlement, which is otherwise impossible before Canva accepts the app into
# the Premium Apps Program. Ignored entirely when NODE_ENV=production.
# Must be paired with FORCE_PREMIUM_LOCALLY in src/premium/config.ts.
PREMIUM_DEV_OVERRIDE=false
